# Firebase web app config (public — restricted via Firestore/Auth rules, not secrecy)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_DATABASE_URL=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Set to "true" to connect the Firestore/Auth SDKs to the local Firebase
# emulator suite (firebase emulators:start) instead of the live project.
PUBLIC_FIREBASE_USE_EMULATOR=false
