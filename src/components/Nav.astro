---
/**
 * Nav.astro — C1 site navigation.
 * Top rule 3px + bottom hairline. Wordmark left (Kumar in accent).
 * Text links: Blog, About. Separator. Icon-only socials. Theme toggle.
 */
interface Props {
  /** Active pathname, e.g. "/", "/blog", "/about" */
  current?: string;
}
const { current = '/' } = Astro.props;

const active = (href: string) =>
  current === href || (href !== '/' && current.startsWith(href));
---

<header class="nav">
  <a href="/" class="wordmark" aria-label="Chandan Kumar — home">
    Chandan <span class="accent">Kumar</span>
  </a>

  <nav class="links" aria-label="Site navigation">
    <a href="/blog"  class:list={["link", { underline: active('/blog')  }]}>Blog</a>
    <a href="/about" class:list={["link", { underline: active('/about') }]}>About</a>

    <span class="sep" aria-hidden="true"></span>

    <a href="https://twitter.com/ch4nd4n"   class="icon-link" aria-label="Twitter" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg>
    </a>
    <a href="https://instagram.com/ch4nd4n" class="icon-link" aria-label="Instagram" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
    </a>
    <a href="https://github.com/ch4nd4n"    class="icon-link" aria-label="GitHub" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
    </a>

    <!-- Theme toggle — wired via inline script; React island if you prefer -->
    <button id="theme-toggle" class="icon-link" aria-label="Toggle dark mode" type="button">
      <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      <svg id="icon-sun"  width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </button>
  </nav>
</header>

<script>
  // Inline theme toggle — persists to localStorage, applies on load.
  const STORAGE_KEY = 'ck-theme';
  const html = document.documentElement;
  const btn  = document.getElementById('theme-toggle')!;
  const moon = document.getElementById('icon-moon')!;
  const sun  = document.getElementById('icon-sun')!;

  function apply(theme: string) {
    html.setAttribute('data-theme', theme);
    moon.style.display = theme === 'dark' ? 'none'  : '';
    sun.style.display  = theme === 'dark' ? ''      : 'none';
    localStorage.setItem(STORAGE_KEY, theme);
  }

  // Restore on mount
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) apply(saved);

  btn.addEventListener('click', () => {
    apply(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
  });
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    border-top: 3px solid var(--text-primary);
    border-bottom: 1px solid var(--border);
    gap: 24px;
  }

  .wordmark {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-decoration: none;
  }

  .accent { color: var(--accent); }

  .links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .link {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
  }
  .link.underline {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .sep {
    display: inline-block;
    width: 1px;
    height: 16px;
    background: var(--border);
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px;
    transition: color var(--duration-fast) var(--easing-standard);
  }
  .icon-link:hover { color: var(--text-primary); }
</style>
