---
/**
 * PostRow.astro — C1 post row.
 * Left stamp: accent index number + date.
 * Leading category icon + tag meta above title.
 * Right body: large title, tag run.
 */
import Icon from './Icon.astro';

interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      date: string;
      tags: string[];
      excerpt: string;
      icon: string;
    };
  };
  index: number;
  total: number;
  isLast?: boolean;
}

const { post, index, total, isLast = false } = Astro.props;
const { title, date, tags, icon } = post.data;
const num = String(index + 1).padStart(2, '0');
const tot = String(total).padStart(2, '0');
const href = `/blog/${post.slug}`;

// Format date: "2026-05-12" → "May 12, 2026"
const dateObj = new Date(date);
const formatted = dateObj.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<article class:list={['row', { 'row--last': isLast }]}>
  <!-- Left stamp -->
  <div class="stamp">
    <div class="index">
      <span class="num">{num}</span>
      <span class="total"> / {tot}</span>
    </div>
    <div class="date">{formatted}</div>
  </div>

  <!-- Icon box -->
  <div class="icon-box" aria-hidden="true">
    <Icon name={icon} size={18} stroke={1.6} />
  </div>

  <!-- Body -->
  <div class="body">
    <div class="meta">
      <Icon name={icon} size={13} stroke={1.6} class="meta-icon" />
      <span>{formatted}</span>
      <span>—</span>
      <span>{tags.join(' · ')}</span>
    </div>
    <a href={href} class="title-link">
      <h2 class="title">{title}</h2>
    </a>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 120px 44px 1fr;
    gap: var(--space-8);
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }
  .row--last { border-bottom: none; }

  .stamp { display: flex; flex-direction: column; gap: 6px; }

  .index { font-size: 14px; font-weight: 700; font-feature-settings: "tnum"; }
  .num   { color: var(--accent); letter-spacing: 0.02em; }
  .total { color: var(--text-muted); font-weight: 400; }
  .date  { font-size: 12px; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; font-weight: 500; }

  .icon-box {
    width: 36px;
    height: 36px;
    margin-top: 2px;
    border: 1px solid var(--border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .body { display: flex; flex-direction: column; gap: 6px; }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .meta-icon { flex-shrink: 0; }

  .title-link { text-decoration: none; color: var(--text-primary); }
  .title-link:hover .title { text-decoration: underline; text-decoration-thickness: 2px; }

  .title {
    margin: 0;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: var(--space-3); }
    .stamp { flex-direction: row; align-items: baseline; gap: var(--space-4); }
    .icon-box { display: none; }
    .title { font-size: 22px; }
  }
</style>
