---
/**
 * index.astro — home page.
 * C1 layout: hero (big name + bio + social rail) + 3 latest posts.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Icon from '../components/Icon.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted   = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const SOCIAL = [
  { name: 'x',         label: 'Twitter',   href: 'https://twitter.com/ch4nd4n'   },
  { name: 'instagram', label: 'Instagram',  href: 'https://instagram.com/ch4nd4n' },
  { name: 'github',    label: 'GitHub',     href: 'https://github.com/ch4nd4n'    },
  { name: 'rss',       label: 'RSS',        href: '/rss.xml'                      },
];
---

<BaseLayout>
  <main>
    <!-- ── Hero ────────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-left">
        <div class="eyebrow">
          <Icon name="dot" size={9} class="eyebrow-dot" />
          <span>№ 01 — HOME</span>
        </div>
        <div class="meta-stack">
          <span>Personal blog</span>
          <span>Bangalore · 12.97°N</span>
          <span>Est. 2014</span>
        </div>
        <div class="stats">
          <div class="stat">
            <div class="stat-n">{sorted.length}</div>
            <div class="stat-l">Posts</div>
          </div>
          <div class="stat">
            <div class="stat-n">10y</div>
            <div class="stat-l">Writing</div>
          </div>
        </div>
        <div class="now">
          <span class="now-dot">● Now</span>
          <span>Java · NodeJS</span>
        </div>
      </div>

      <div class="hero-right">
        <h1 class="name">
          Chandan<br /><span class="name-accent">Kumar</span>
        </h1>
        <p class="bio">
          <span class="yo">Yo!</span> Personal blog by Chandan Kumar.
          I write about software, photographs and tutorials.
          ex-Liftoff, ex-Coreobjects.
        </p>

        <!-- Compact mobile stats row — hero-left's content, re-flowed for small screens -->
        <div class="mobile-stats" aria-hidden="false">
          <div class="mobile-stat">
            <span class="mobile-stat-n">{sorted.length}</span>
            <span class="mobile-stat-l">Posts</span>
          </div>
          <div class="mobile-stat">
            <span class="mobile-stat-n">10y</span>
            <span class="mobile-stat-l">Writing</span>
          </div>
          <div class="mobile-stat mobile-stat--now">
            <span class="mobile-stat-n">Now</span>
            <span class="mobile-stat-l">Java · NodeJS</span>
          </div>
        </div>

        <nav class="social-rail" aria-label="Social links">
          {SOCIAL.map(s => (
            <a href={s.href} class="social-link" target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              <Icon name={s.name} size={16} stroke={1.6} />
              <span>{s.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- ── Latest posts ─────────────────────────────────────────────── -->
    <PostList
      posts={sorted}
      heading="Latest writing"
      sectionNumber="02"
      limit={3}
      showAllLink
      showAllButton
    />
  </main>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-8);
    align-items: start;
    padding: var(--space-12) 0 var(--space-8);
    min-height: 380px;
  }

  /* ── Left rail ── */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: 14px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  :global(.eyebrow-dot) { color: var(--accent); }

  .meta-stack {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.7;
    display: flex;
    flex-direction: column;
  }

  .stats {
    border-top: 1px solid var(--border);
    padding-top: var(--space-4);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .stat-n {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    font-feature-settings: "tnum";
  }
  .stat-l {
    margin-top: 4px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .now {
    border-top: 1px solid var(--border);
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .now-dot { color: var(--accent); font-weight: 700; font-size: 10px; }

  /* ── Right ── */
  .hero-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .name {
    font-size: clamp(64px, 11vw, 144px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.85;
    margin: 0;
    color: var(--text-primary);
  }
  .name-accent { color: var(--accent); }

  .bio {
    margin: var(--space-8) 0;
    font-size: 22px;
    line-height: 1.45;
    color: var(--text-primary);
    max-width: 32rem;
    letter-spacing: -0.01em;
  }
  .yo { color: var(--accent); font-weight: 600; }

  .social-rail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--easing-standard);
  }
  .social-link:hover { color: var(--text-primary); }

  /* ── Mobile compact stats row (hidden by default; shown < 640px) ── */
  .mobile-stats {
    display: none;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: var(--space-3) 0;
    margin: var(--space-4) 0;
    gap: var(--space-4);
  }
  .mobile-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-right: var(--space-4);
    border-right: 1px solid var(--border);
  }
  .mobile-stat:last-child { border-right: none; padding-right: 0; }
  .mobile-stat-n {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-feature-settings: "tnum";
  }
  .mobile-stat--now .mobile-stat-n { color: var(--accent); }
  .mobile-stat-l {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* ── Tablet — mid-range breakpoint: tighten the 200px rail before it collapses ── */
  @media (max-width: 860px) and (min-width: 641px) {
    .hero { grid-template-columns: 160px 1fr; gap: var(--space-6); }
    .meta-stack { font-size: 10px; }
    .name { font-size: clamp(56px, 10vw, 96px); }
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; min-height: unset; padding: var(--space-8) 0; }
    .hero-left { display: none; }
    .mobile-stats { display: flex; }
    .name { font-size: 64px; }
    .bio  { font-size: 19px; margin: var(--space-6) 0; }
  }
</style>
