---
/**
 * about.astro — About page.
 * C1: "Hello, world." hero in accent. Sections № 01–03 with leading icons.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="About" description="About Chandan Kumar — software engineer in Bangalore.">
  <!-- Hero -->
  <header class="about-hero">
    <div class="about-eyebrow">
      <Icon name="dot" size={9} />
      <span>ABOUT</span>
      <span class="divider">·</span>
      <Icon name="mapPin" size={12} stroke={1.6} />
      <span>Bangalore, IN</span>
    </div>
    <h1 class="about-title">Hello,<br /><span class="accent">world.</span></h1>
  </header>

  <!-- Sections -->
  <div class="sections">

    <section class="about-section">
      <div class="section-label">
        <div class="section-num">
          <Icon name="pen" size={15} stroke={1.7} />
          <span>№ 01</span>
        </div>
        <span class="label-text">Who</span>
      </div>
      <div class="section-body">
        <p>
          If it isn't obvious; name Chandan Kumar. Age is inconsistent, albeit
          consistently been (more or less) in Bangalore. I work as a Software
          Engineer — these days dabbling between Java and NodeJS.
        </p>
        <p>
          I'm not fascinated by any specific language and find flaws with every
          stack. IMO optimizing application performance is exciting, tiring and
          painfully tiring, sometimes.
        </p>
      </div>
    </section>

    <section class="about-section">
      <div class="section-label">
        <div class="section-num">
          <Icon name="code" size={15} stroke={1.7} />
          <span>№ 02</span>
        </div>
        <span class="label-text">Site</span>
      </div>
      <div class="section-body">
        <p>
          Powered by Astro. Plain old HTML, topped with CSS and a touch of
          JavaScript. The design system lives at chandankumar.com/ds.
        </p>
        <p>
          <del>I would like to make this PWA but thats for another time.</del>{' '}
          PWA is an ongoing process and I hope to keep adding something over time.
        </p>
      </div>
    </section>

    <section class="about-section">
      <div class="section-label">
        <div class="section-num">
          <Icon name="rss" size={15} stroke={1.7} />
          <span>№ 03</span>
        </div>
        <span class="label-text">Find me</span>
      </div>
      <div class="section-body">
        <div class="social-grid">
          {[
            { icon: 'x',         label: 'Twitter',   handle: '@ch4nd4n', href: 'https://twitter.com/ch4nd4n'   },
            { icon: 'instagram', label: 'Instagram',  handle: '@ch4nd4n', href: 'https://instagram.com/ch4nd4n' },
            { icon: 'github',    label: 'GitHub',     handle: 'ch4nd4n',  href: 'https://github.com/ch4nd4n'    },
            { icon: 'rss',       label: 'RSS',        handle: 'Feed',     href: '/rss.xml'                      },
          ].map(s => (
            <a href={s.href} class="social-row" target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              <Icon name={s.icon} size={17} stroke={1.6} class="social-icon" />
              <span class="social-label">{s.label}</span>
              <span class="social-handle">{s.handle}</span>
              <Icon name="arrowUR" size={12} stroke={1.8} class="social-arrow" />
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .about-hero {
    padding: var(--space-12) 0 var(--space-8);
    border-bottom: 1px solid var(--border);
  }

  .about-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.18em;
    margin-bottom: var(--space-6);
  }
  .divider { color: var(--text-muted); }

  .about-title {
    font-size: clamp(72px, 11vw, 144px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.85;
    margin: 0;
    color: var(--text-primary);
  }
  .accent { color: var(--accent); }

  /* ── Sections ── */
  .sections { display: flex; flex-direction: column; }

  .about-section {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-12);
    align-items: start;
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--border);
  }

  .section-label { padding-top: 4px; }

  .section-num {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
  }

  .label-text {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .section-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .section-body p {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  /* ── Social grid ── */
  .social-grid { display: flex; flex-direction: column; }

  .social-row {
    display: grid;
    grid-template-columns: 20px 100px 1fr 16px;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 16px;
    transition: color var(--duration-fast) var(--easing-standard);
  }
  .social-row:last-child { border-bottom: none; }
  .social-row:hover { color: var(--accent); }

  :global(.social-icon) { color: var(--text-muted); }
  .social-label          { font-weight: 500; }
  .social-handle         { color: var(--text-muted); }
  :global(.social-arrow) { color: var(--text-muted); }

  @media (max-width: 640px) {
    .about-section { grid-template-columns: 1fr; gap: var(--space-4); }
    .social-row    { grid-template-columns: 20px 1fr 16px; }
    .social-handle { display: none; }
  }
</style>
