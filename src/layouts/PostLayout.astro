---
/**
 * PostLayout.astro — individual post shell.
 * Large title in accent, date + tag meta, prose body.
 */
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CommentSection from '../components/comments/CommentSection';

interface Props {
  title: string;
  date: string;
  tags: string[];
  excerpt: string;
  icon: string;
  slug: string;
}

const { title, date, tags, excerpt, icon, slug } = Astro.props;

const dateObj   = new Date(date);
const formatted = dateObj.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title={title} description={excerpt}>
  <article class="post">
    <!-- Back link -->
    <a href="/blog" class="back">← All posts</a>

    <!-- Header -->
    <header class="post-header">
      <div class="post-meta">
        <Icon name={icon} size={13} stroke={1.6} />
        <span>{formatted}</span>
        <span>—</span>
        <span class="tags">{tags.join(' · ')}</span>
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-excerpt">{excerpt}</p>
      <div class="rule"></div>
    </header>

    <!-- Body (Markdown renders into .prose) -->
    <div class="prose">
      <slot />
    </div>

    <CommentSection slug={slug} client:load />

    <!-- Tag footer -->
    <footer class="post-footer">
      <div class="tag-row">
        {tags.map(tag => (
          <a href={`/blog?tag=${tag}`} class="tag">{tag}</a>
        ))}
      </div>
      <a href="/blog" class="back-bottom">← Back to archive</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin: var(--space-8) 0 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--text-primary); }

  .post-header {
    padding: var(--space-8) 0 var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .post-title {
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
    color: var(--accent);
    margin: 0 0 var(--space-6);
    max-width: 20ch;
  }

  .post-excerpt {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
    max-width: var(--measure-prose);
    margin: 0;
  }

  .rule {
    height: 1px;
    background: var(--border);
    margin-top: var(--space-6);
  }

  .prose { margin-top: var(--space-8); }

  .post-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .tag-row { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  .tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    padding: 4px 8px;
    border: 1px solid var(--border);
  }
  .tag:hover { border-color: var(--border-strong); color: var(--text-primary); }

  .back-bottom {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back-bottom:hover { color: var(--text-primary); }
</style>
