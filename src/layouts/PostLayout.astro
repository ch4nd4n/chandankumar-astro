---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  excerpt?: string;
}

const { title, date, tags = [], excerpt } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${title} — Chandan Kumar`} description={excerpt} current="blog">
  <article class="post-article">
    <header class="post-header">
      <div class="post-meta">
        <div class="post-meta-num">№ 01</div>
        <div class="post-meta-date">{dateStr}</div>
        {tags.length > 0 && (
          <div class="post-meta-tags">
            {tags.map(t => <div>{t}</div>)}
          </div>
        )}
      </div>
      <h1 class="post-headline">{title}</h1>
    </header>

    <div class="prose">
      <slot />
    </div>

    <div class="post-back">
      <a href="/blog">← All posts</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post-article {
    padding-bottom: var(--space-24);
  }
  .post-header {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-6);
    border-top: 3px solid var(--text-primary);
    margin-bottom: var(--space-12);
  }
  .post-meta {
    padding-top: var(--space-2);
  }
  .post-meta-num {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .post-meta-date {
    margin-top: var(--space-2);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .post-meta-tags {
    margin-top: var(--space-4);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
    line-height: 1.7;
  }
  .post-headline {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 20ch;
  }
  .prose {
    max-width: var(--measure-prose);
    margin-left: 192px;
    font-size: 19px;
    line-height: 1.7;
  }
  .prose :global(p) { margin-bottom: 1.4em; }
  .prose :global(h2) {
    margin: 1.8em 0 0.6em;
    font-size: 26px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .prose :global(h3) {
    margin: 1.4em 0 0.4em;
    font-size: 20px;
  }
  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.4em;
    padding-left: var(--space-6);
  }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--border-strong);
    margin: 0 0 1.4em;
    padding: var(--space-2) var(--space-6);
    color: var(--text-muted);
    font-style: italic;
  }
  .prose :global(img) {
    max-width: 100%;
    border: 1px solid var(--border);
    display: block;
    margin-bottom: 1.4em;
  }
  .post-back {
    margin-top: var(--space-16);
    margin-left: 192px;
    font-size: var(--text-sm);
  }
  @media (max-width: 640px) {
    .post-header {
      grid-template-columns: 1fr;
    }
    .prose {
      margin-left: 0;
    }
    .post-back {
      margin-left: 0;
    }
  }
</style>
